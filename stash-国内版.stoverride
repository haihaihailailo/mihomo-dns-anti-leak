  tiktok:
    type: http
    behavior: domain
    format: mrs
    interval: 86400
    url: https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/tiktok.mrs
    path: ./ruleset/metacubex/tiktok.mrs
  spotify:
    type: http
    behavior: domain
    format: mrs
    interval: 86400
    url: https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/spotify.mrs
    path: ./ruleset/metacubex/spotify.mrs
  apple:
    type: http
    behavior: domain
    format: mrs
    interval: 86400
